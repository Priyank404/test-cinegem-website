# =============================================================================
# Google Drive API & Media Sync Configuration
# =============================================================================

# Google Drive API Key (Google Cloud Console with Google Drive API v3 enabled)
VITE_GOOGLE_DRIVE_API=your_google_drive_api_key_here

# Google Drive Folder IDs (Assets are automatically fetched directly from these folders)
# 1. Home Page Visuals (Optional dedicated folder; if empty, automatically pulls from sections below)
VITE_HOMEPAGE_FOLDER_ID=

# 2. Creative Visuals (/creative-visuals)
VITE_CREATIVE_VISUALS_FOLDER_ID=1ZiU5sda-gbZCnkc_E_FEtw6c0RSYVPHT

# 3. Classic E-Commerce Visuals (/classic)
VITE_ECOM_VISUALS_FOLDER_ID=178a7pQWVMnZhH1Lnsr19rfupV73kFznh

# 4. On-Body Visualization (/onbody)
VITE_ON_BODY_FOLDER_ID=1yU3LwOU5l8ZJkvwKwLkN80lGFMB5esnY

# 5. Creative Animation
VITE_CREATIVE_ANIMATION_FOLDER_ID=1rqrfSlIpWcvYiAJqfKJYCx09U6TM_RdC

# 6. 360 Turntable / Animation
VITE_360_ANIMATION_FOLDER_ID=1czxcFB5BWmYhnOg-bYNEJx1Jubwoil8o

# -----------------------------------------------------------------------------
# Application Environment Mode
# 'dev' (shows 3D timeline, dev panels, tuning controls) | 'production' (clean viewer experience)
# -----------------------------------------------------------------------------
VITE_APP_MODE=production
